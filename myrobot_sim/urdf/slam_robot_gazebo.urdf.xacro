<?xml version="1.0"?>

<robot name="slam_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
  <material name="yellow"><color rgba="1.0 0.85 0.0 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="caster_grey"><color rgba="0.35 0.35 0.35 1"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.9 1"/></material>

  <link name="base_link">
    <visual name="level_1_plate">
      <origin xyz="0.00000 0.00000 0.00000" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://myrobot_sim/meshes/bottom_plate.stl"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision name="level_1_plate_col">
      <origin xyz="0.00000 0.00000 0.00000" rpy="0 0 0"/>
      <geometry><mesh filename="package://myrobot_sim/meshes/bottom_plate.stl"/></geometry>
    </collision>

    <visual name="level_2_plate">
      <origin xyz="0.00000 0.00000 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.00300"/></geometry>
      <material name="orange"/>
    </visual>

    <collision name="level_2_plate_col">
      <origin xyz="0.00000 0.00000 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.00300"/></geometry>
    </collision>

    <visual name="level_3_plate">
      <origin xyz="0.00000 0.00000 0.24000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.00300"/></geometry>
      <material name="orange"/>
    </visual>

    <collision name="level_3_plate_col">
      <origin xyz="0.00000 0.00000 0.24000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.00300"/></geometry>
    </collision>

    <visual name="pcb_stand_1">
      <origin xyz="0.08132 0.08132 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.24000"/></geometry>
      <material name="yellow"/>
    </visual>

    <collision name="pcb_stand_1_col">
      <origin xyz="0.08132 0.08132 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.24000"/></geometry>
    </collision>

    <visual name="pcb_stand_2">
      <origin xyz="-0.08132 0.08132 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.24000"/></geometry>
      <material name="yellow"/>
    </visual>

    <collision name="pcb_stand_2_col">
      <origin xyz="-0.08132 0.08132 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.24000"/></geometry>
    </collision>

    <visual name="pcb_stand_3">
      <origin xyz="-0.08132 -0.08132 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.24000"/></geometry>
      <material name="yellow"/>
    </visual>

    <collision name="pcb_stand_3_col">
      <origin xyz="-0.08132 -0.08132 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.24000"/></geometry>
    </collision>

    <visual name="pcb_stand_4">
      <origin xyz="0.08132 -0.08132 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.24000"/></geometry>
      <material name="yellow"/>
    </visual>

    <collision name="pcb_stand_4_col">
      <origin xyz="0.08132 -0.08132 0.12000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.24000"/></geometry>
    </collision>

    <visual name="front_caster">
      <origin xyz="0.1 0 -0.01697" rpy="0 0 0"/>
      <geometry><sphere radius="0.01697"/></geometry>
      <material name="caster_grey"/>
    </visual>

    <collision name="front_caster_col">
      <origin xyz="0.1 0 -0.01697" rpy="0 0 0"/>
      <geometry><sphere radius="0.01697"/></geometry>
    </collision>

    <visual name="rear_caster">
      <origin xyz="-0.1 0 -0.01697" rpy="0 0 0"/>
      <geometry><sphere radius="0.01697"/></geometry>
      <material name="caster_grey"/>
    </visual>

    <collision name="rear_caster_col">
      <origin xyz="-0.1 0 -0.01697" rpy="0 0 0"/>
      <geometry><sphere radius="0.01697"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.01564" ixy="0" ixz="0" iyy="0.01564" iyz="0" izz="0.01687"/>
    </inertial>
  </link>

  <link name="left_motor_link">
    <visual name="left_motor_tyre">
      <origin xyz="0.00000 0.00000 0.00000" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.034" length="0.02600"/></geometry>
      <material name="black"/>
    </visual>
    <collision name="left_motor_tyre_col">
      <origin xyz="0.00000 0.00000 0.00000" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.034" length="0.02600"/></geometry>
    </collision>
    <visual name="left_motor_axle">
      <origin xyz="0.00000 0.00000 0.00000" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.006" length="0.03400"/></geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000345" ixy="0" ixz="0" iyy="0.0000578" iyz="0" izz="0.0000345"/>
    </inertial>
  </link>

  <link name="right_motor_link">
    <visual name="right_motor_tyre">
      <origin xyz="0.00000 0.00000 0.00000" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.034" length="0.02600"/></geometry>
      <material name="black"/>
    </visual>
    <collision name="right_motor_tyre_col">
      <origin xyz="0.00000 0.00000 0.00000" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.034" length="0.02600"/></geometry>
    </collision>
    <visual name="right_motor_axle">
      <origin xyz="0.00000 0.00000 0.00000" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.006" length="0.03400"/></geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000345" ixy="0" ixz="0" iyy="0.0000578" iyz="0" izz="0.0000345"/>
    </inertial>
  </link>

  <link name="lidar_link">
    <visual name="lidar">
      <origin xyz="0.00000 0.00000 0.00000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.03400"/></geometry>
      <material name="black"/>
    </visual>
    <collision name="lidar_col">
      <origin xyz="0.00000 0.00000 0.00000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.03400"/></geometry>
    </collision>
    <inertial>
      <mass value="0.114"/>
      <inertia ixx="0.0000459" ixy="0" ixz="0" iyy="0.0000459" iyz="0" izz="0.0000698"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_motor_link"/>
    <origin xyz="0 0.0825 0.00000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="10.47"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_motor_link"/>
    <origin xyz="0 -0.0825 0.00000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="10.47"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.25850" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>100000.0</kp>
    <kd>200.0</kd>
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="left_motor_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_motor_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_driver" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
    <material>Gazebo/Blue</material>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.7</param>
        <param name="max">10.7</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.7</param>
        <param name="max">10.7</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find myrobot_sim)/config/controllers.yaml</parameters>
      <ros>
        <remapping>diff_cont/cmd_vel_unstamped:=cmd_vel</remapping>
        <remapping>diff_cont/odom:=odom</remapping>
      </ros>
    </plugin>
  </gazebo>

</robot>
